# Program 4: Class with user-defined method
# Defines a BankAccount class with deposit and withdraw methods
class BankAccount:
    def __init__(self, owner, balance=0):
        self.owner = owner
        self.balance = balance

    def deposit(self, amount):
        self.balance += amount
        print(f" Deposited {amount}, New Balance: {self.balance}")

    def withdraw(self, amount):
        if amount <= self.balance:
            self.balance -= amount
            print(f" Withdrawn {amount}, New Balance: {self.balance}")
        else:
            print(" Insufficient balance!")

# User input
owner = input("Enter account owner name: ")
acc = BankAccount(owner)

acc.deposit(int(input("Enter deposit amount: ")))
acc.withdraw(int(input("Enter withdraw amount: ")))

#output;
# Enter account owner name: amrit
# Enter deposit amount: 2000
#  Deposited 2000, New Balance: 2000
# Enter withdraw amount: 1500
#  Withdrawn 1500, New Balance: 500





# Program 5: Multiple objects of a class
# Defines a Book class and creates multiple objects
class Book:
    def __init__(self, title, author):
        self.title = title
        self.author = author

    def info(self):
        print(f" '{self.title}' by {self.author}")

# User input
n = int(input("Enter number of books: "))
books = []
for i in range(n):
    title = input(f"Enter title of book {i+1}: ")
    author = input(f"Enter author of book {i+1}: ")
    books.append(Book(title, author))

print(" Book details:")
for b in books:
    b.info()

#output;
# Enter number of books: 2
# Enter title of book 1: math2
# Enter author of book 1: math4
# Enter title of book 2: math6
# Enter author of book 2: math8
#  Book details:
#  'math2' by math4
#  'math6' by math8



