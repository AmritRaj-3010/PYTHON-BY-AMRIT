# Program 1: Class Method Example
# Uses @classmethod to create object from alternative input
class Student:
    def __init__(self, name, roll):
        self.name = name
        self.roll = roll

    @classmethod
    def from_string(cls, data_str):
        name, roll = data_str.split("-")
        return cls(name, roll)

data = input("Enter student data (name-roll): ")
s = Student.from_string(data)
print(f" Student: {s.name}, Roll: {s.roll}")

#output;
# Enter student data (name-roll): aman-5
#  Student: aman, Roll: 5





# Program 2: Static Method Example
# Uses @staticmethod for utility function
class MathOps:
    @staticmethod
    def add(a, b):
        return a + b

x = int(input("Enter first number: "))
y = int(input("Enter second number: "))
print(" Sum:", MathOps.add(x, y))

#output;
# Enter first number: 23
# Enter second number: 33
#  Sum: 56





# Program 3: Class Method for counting objects
class Employee:
    count = 0

    def __init__(self, name):
        self.name = name
        Employee.count += 1

    @classmethod
    def total_employees(cls):
        return cls.count

n = int(input("Enter number of employees: "))
