# Program 4: Static Method for validation
class Validator:
    @staticmethod
    def is_positive(num):
        return num > 0

num = int(input("Enter a number: "))
if Validator.is_positive(num):
    print(" Number is positive")
else:
    print(" Number is not positive")

#output;
# Enter a number: 54
#  Number is positive





# Program 5: Combined Class & Static Methods
class BankAccount:
    accounts = []

    def __init__(self, owner, balance=0):
        self.owner = owner
        self.balance = balance
        BankAccount.accounts.append(self)

    @classmethod
    def total_accounts(cls):
        return len(cls.accounts)

    @staticmethod
    def bank_policy():
        return " Minimum balance must be 1000"

owner = input("Enter account owner: ")
balance = int(input("Enter initial balance: "))
acc = BankAccount(owner, balance)

print(" Total accounts:", BankAccount.total_accounts())
print(" Bank policy:", BankAccount.bank_policy())

