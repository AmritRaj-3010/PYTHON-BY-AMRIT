# Program 3: Mode of numbers
# User enters numbers, program calculates mode
import statistics

nums = list(map(float, input("Enter numbers separated by space: ").split()))
try:
    print(f" Mode of numbers is {statistics.mode(nums)}")
except statistics.StatisticsError:
    print(" No unique mode found (all values equally frequent)")

# output:
# Enter numbers separated by space: 4 5 6 7 8 9
#  Mode of numbers is 4.0




