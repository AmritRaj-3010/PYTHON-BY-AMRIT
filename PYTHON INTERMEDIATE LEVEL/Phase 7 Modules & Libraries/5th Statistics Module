# Program 1: Mean of numbers
# User enters numbers, program calculates mean
import statistics

nums = list(map(float, input("Enter numbers separated by space: ").split()))
print(f" Mean of numbers is {statistics.mean(nums)}")

# output:
# Enter numbers separated by space: 4 5 6 7 8
#  Mean of numbers is 6.0




