# Program 4: Read JSON file
# User enters file name, program reads and prints data
import json

filename = input("Enter JSON file name: ")
try:
    with open(filename, "r") as f:
        data = json.load(f)
    print(" Data from file:", data)
except FileNotFoundError:
    print(" File not found!")

#output;
# Enter JSON file name: faltudata.json
#  Data from file: {'354': '456', '234': '345', '678': '876', '567': '876'}




# Program 5: Update JSON file
# User enters file name and new key-value, program updates JSON file
import json

filename = input("Enter JSON file name: ")
try:
    with open(filename, "r") as f:
        data = json.load(f)

    key = input("Enter key to add/update: ")
    value = input("Enter value: ")
    data[key] = value

    with open(filename, "w") as f:
        json.dump(data, f, indent=4)

    print(f" File '{filename}' updated successfully!")
except FileNotFoundError:
    print(" File not found!")

#output;
# Enter JSON file name: faltudata.json
# Enter key to add/update: 2344
# Enter value: 5433
#  File 'faltudata.json' updated successfully!

