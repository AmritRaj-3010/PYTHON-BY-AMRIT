# Program 2: Convert JSON string to Python dictionary
# User enters JSON string, program converts back to dictionary
import json

json_str = input("Enter JSON string: ")
try:
    data = json.loads(json_str)
    print(" Converted to Python dictionary:", data)
except json.JSONDecodeError:
    print(" Invalid JSON format!")

#output;
# Enter JSON string: {"name": "Amrit", "course": "Python"}
#  Converted to Python dictionary: {'name': 'Amrit', 'course': 'Python'}




# Program 3: Save dictionary to JSON file
# User enters data, program saves it into a JSON file
import json

data = {}
n = int(input("Enter number of items: "))
for i in range(n):
    key = input("Enter key: ")
    value = input("Enter value: ")
    data[key] = value

filename = input("Enter file name (e.g., data.json): ")
with open(filename, "w") as f:
    json.dump(data, f, indent=4)

print(f" Data saved to {filename}")

