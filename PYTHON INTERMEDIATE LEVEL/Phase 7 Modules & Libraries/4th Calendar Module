# Program 3: Check if a year is leap year or not
# User enters year, program checks year is leap year or not
import calendar

year = int(input("Enter year: "))
if calendar.isleap(year):
    print(f"{year} is a leap year")
else:
    print(f"{year} is not a leap year")

# output:
# nter year: 2030
# 2030 is not a leap year





# Program 4: Find numbers of leap year in a range
# User enters start and end years , program counts number of leap years
import calendar

start = int(input("Enter start year :"))
end = int(input("Enter end year :"))

count = calendar.leapdays(start , end+1)
print(f"Number of leap years between {start} to {end} = {count}")

# output:
# Enter start year :2005
# Enter end year :2026
# Number of leap years between 2005 to 2026 = 5




# Program 5: Find weekday of a given date
# User enters year, month, day, program tells the weekday
import calendar

year = int(input("Enter year: "))
month = int(input("Enter month (1-12): "))
date = int(input("Enter date: "))

weekday = calendar.weekday(year, month, date)
days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

print(f" The date {date}/{month}/{year} is a {days[weekday]}")


# output:
# Enter year: 2026
# Enter month (1-12): 10
# Enter date: 30
#  The date 30/10/2026 is a Friday


