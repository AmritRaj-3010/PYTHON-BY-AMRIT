# Program 4: Infinite cycle
# User enters items, program cycles through them a fixed number of times
import itertools

items = input("Enter items separated by space: ").split()
n = int(input("Enter how many values to display: "))

print(" Cycling through items:")
for i, val in zip(range(n), itertools.cycle(items)):
    print(val)

#output;
# Enter items separated by space: red orange blue pink yellow green
# Enter how many values to display: 4
#  Cycling through items:
# red
# orange
# blue
# pink




# Program 5: Accumulate sums
# User enters numbers, program shows cumulative sums
import itertools

nums = list(map(int, input("Enter numbers separated by space: ").split()))
print(" Cumulative sums:")
for total in itertools.accumulate(nums):
    print(total)

#output;
# Enter numbers separated by space: 56 65 78 70
#  Cumulative sums:
# 56
# 121
# 199
# 269



