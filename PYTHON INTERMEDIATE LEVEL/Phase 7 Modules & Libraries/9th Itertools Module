# Program 1: Generate permutations
# User enters items, program generates all possible permutations
import itertools

items = input("Enter items separated by space: ").split()
print(" Permutations:")
for p in itertools.permutations(items):
    print(p)

#output;
# Enter items separated by space: red pink yellow
#  Permutations:
# ('red', 'pink', 'yellow')
# ('red', 'yellow', 'pink')
# ('pink', 'red', 'yellow')
# ('pink', 'yellow', 'red')
# ('yellow', 'red', 'pink')
# ('yellow', 'pink', 'red')




# Program 2: Generate combinations
# User enters items and size, program generates all possible combinations
import itertools

items = input("Enter items separated by space: ").split()
r = int(input("Enter combination size: "))
print(f" Combinations of size {r}:")
for c in itertools.combinations(items, r):
    print(c)

